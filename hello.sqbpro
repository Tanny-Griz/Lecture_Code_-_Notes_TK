SELECT * FROM cats WHERE age &lt; 12;
SELECT name FROM cats;
INSERT INTO cats VALUES ('Socks', 4);
UPDATE cats
SET age = 12
WHERE name = 'Socks';

CREATE TABLE movies (
    name TEXT,
    stars INTEGER,
    watched BOOLEAN
);

INSERT INTO movies VALUES ('Batman', 0, false);
INSERT INTO movies VALUES ('Wonder Woman', 4, true);
INSERT INTO movies VALUES ('Black Panther', 5, true);
INSERT INTO movies VALUES ('Captain Marvel', 5, true);
INSERT INTO movies VALUES ('Spiderman', 0, false);

SELECT * FROM movies;

-- All movies, only two columns
SELECT name, watched FROM movies;

-- All columns, only unwatched movies
SELECT * FROM movies WHERE watched = false;

-- All columns, movies rated 4 or higher
SELECT * FROM movies WHERE stars &gt;= 4;

UPDATE movies
SET stars = 4
WHERE name = 'Spiderman';

-- 1. Select movies rated over 2 stars
SELECT * FROM movies WHERE stars &gt; 2;

-- 2. Select movies containing &quot;t&quot; in the title
SELECT * FROM movies WHERE name LIKE '%t%';

-- 3. Delete all unwatched movies
DELETE FROM movies WHERE watched = false;


</sql><current_tab id="0"/></tab_sql></sqlb_project>
